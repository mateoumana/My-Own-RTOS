# ==========================================================
#  .gitignore - STM32 (CubeMX + CMake + VS Code)
# ==========================================================

# ---------- Compilación (CMake / Ninja) ----------
build/
out/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
*.ninja
.ninja_deps
.ninja_log

# ---------- Binarios y artefactos del compilador ----------
*.elf
*.bin
*.hex
*.srec
*.map
*.list
*.lst
*.o
*.obj
*.a
*.d
*.su
*.cyclo

# ---------- Restos de STM32CubeIDE (Eclipse) ----------
Debug/
Release/
.metadata/
*.launch

# ---------- CubeMX: copias de respaldo temporales ----------
*.ioc.bak
*.bak

# ---------- VS Code ----------
# Se ignora la carpeta, pero se conservan los archivos de configuración útiles
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# ---------- clangd / IntelliSense ----------
.cache/
.clangd/
*.ipch

# ---------- Sistema operativo ----------
.DS_Store
Thumbs.db
desktop.ini